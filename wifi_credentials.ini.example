; Local build config template: WiFi credentials, the FDN server key pin, and the FDN codeword
; Copy this file to wifi_credentials.ini and fill in your actual values
; The wifi_credentials.ini file is excluded from git for security
; Every build needs this file, because PlatformIO reads it when it loads the
; project; only FDN images embed the [wifi] values
[wifi]
WIFI_SSID = YourWiFiSSID
WIFI_PASSWORD = YourWiFiPassword
BASE_URL = https://your-api-endpoint.com/api/v1
; FDN only: the one server key the FDN trusts, as the SHA-256 of the server
; certificate's DER public key (64 hex digits). Compute it from the server's
; certificate and paste only the hex after "= ":
;   openssl x509 -in server.crt -pubkey -noout | openssl pkey -pubin -outform DER | openssl dgst -sha256
; Left empty, or anything but 64 hex digits, the FDN trusts no server: every
; https request fails, so it registers nobody and uploads nothing. A new server
; key means reflashing every FDN.
SERVER_KEY_SHA256 =

[fdn]
; Symbol-match codeword this FDN shows on a win. One build per unit: a multi-board
; flash puts the same word on every board. Use plain ASCII letters, digits and
; spaces (punctuation can break the build); about 11 letters fit the screen
; (8 if heavy on M or W).
FDN_CODEWORD = CODEWORD
