; Local build config template: WiFi credentials, server addresses, and the FDN codeword
; Copy this file to wifi_credentials.ini and fill in your actual values
; The wifi_credentials.ini file is excluded from git for security
; Only FDN builds read it and only FDN images embed its values; a PDN has no Wi-Fi
[wifi]
WIFI_SSID = YourWiFiSSID
WIFI_PASSWORD = YourWiFiPassword
; The FDN sends requests only to an https:// address, verified against the
; public CA certificates built into ESP-IDF, host name included; any other
; address makes every request fail at once, so the FDN uploads nothing
BASE_URL = https://your-api-endpoint.com/api/v1
; The FDN sets its clock from this NTP server before its first HTTPS request,
; since certificate dates are checked; a closed venue network needs one it can reach
NTP_SERVER = pool.ntp.org

[fdn]
; Symbol-match codeword this FDN shows on a win. One build per unit: a multi-board
; flash puts the same word on every board. Use plain ASCII letters, digits and
; spaces (punctuation can break the build); about 11 letters fit the screen
; (8 if heavy on M or W).
FDN_CODEWORD = CODEWORD
