; Local build config template: WiFi credentials, and the FDN codeword
; Copy this file to wifi_credentials.ini and fill in your actual values
; The wifi_credentials.ini file is excluded from git for security
[wifi]
WIFI_SSID = YourWiFiSSID
WIFI_PASSWORD = YourWiFiPassword
BASE_URL = https://your-api-endpoint.com/api/v1

[fdn]
; Symbol-match codeword this FDN shows on a win. One build per unit: a multi-board
; flash puts the same word on every board. Use plain ASCII letters, digits and
; spaces (punctuation can break the build); about 11 letters fit the screen
; (8 if heavy on M or W).
FDN_CODEWORD = CODEWORD
