# PDN-only, layered over sdkconfig.defaults by CMakeLists.txt.

# An update that resets before the store confirms it (PENDING_IMAGE_CONFIRM_MS into loop()) rolls back.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Covers an unconfirmed image's main task, so it must outlast the slowest loop pass:
# a blocking WiFi connect (5s) or one HTTP perform() (10s per socket operation).
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# RSA-3072 is the S3's only scheme; with this set an unsigned app aborts at startup,
# so scripts/sign_image.py signs every PDN build.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n
