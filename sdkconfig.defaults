# ESP-IDF settings that differ from IDF's defaults. Most reproduce the
# configuration the fleet ran under Arduino, so changing one changes how the
# firmware behaves: test on hardware before changing anything.
#
# Set IDF options here. custom_sdkconfig in platformio.ini is ignored by this build.

# Flash: 8MB chip in DIO mode, the mode the fleet was tested with.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# PSRAM: 8MB, octal, 80MHz.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Use our partitions.csv instead of IDF's built-in table.
CONFIG_PARTITION_TABLE_CUSTOM=y

# Two app slots for wireless updates. A new image must prove itself before it
# becomes permanent: if it resets before confirming, the bootloader goes back
# to the previous slot. The firmware store refuses to compile without this.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Our code throws and catches C++ exceptions; IDF turns them off by default.
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# Save crash dumps to flash so the crash logger can read them after a reboot.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# The speed the game's timing was tuned at: 240MHz CPU, 1ms scheduler tick,
# size-optimised build.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The game loop runs on core 1 and never pauses, so the watchdog must not treat
# that as a hang. A hang on core 0 still reboots the device.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_TASK_WDT_PANIC=y

# About 50ms of button debounce (5 samples, 10ms apart), so one bouncy press
# doesn't count twice. The button driver checks this value at compile time.
CONFIG_BUTTON_PERIOD_TIME_MS=10
CONFIG_BUTTON_DEBOUNCE_TICKS=5

# The fleet's memory layout under Arduino: WiFi buffers in PSRAM, more internal
# RAM left free. Some of these need SPIRAM_IGNORE_NOTFOUND, which also lets a
# board whose PSRAM fails boot anyway, but unable to send ESP-NOW.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=0
