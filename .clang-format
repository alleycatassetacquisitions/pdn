Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
UseTab: Never
# Break long fluent chains (display->invalidateScreen()->...) instead of one line.
ColumnLimit: 100
ContinuationIndentWidth: 0
BreakBeforeBraces: Attach
SpaceBeforeParens: ControlStatements
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false
AccessModifierOffset: -4
BreakConstructorInitializers: BeforeComma
ConstructorInitializerIndentWidth: 4
IndentCaseLabels: true
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortCaseLabelsOnASingleLine: true
FixNamespaceComments: false
SpacesBeforeTrailingComments: 2
# The styleguide groups includes by subsystem and Arduino order is load-bearing; SortIncludes cannot express either.
SortIncludes: Never

---
# Our JSON and proto files are hand-maintained. clang-format has to accept the
# language or it errors out, which aborts a whole git-clang-format run over one
# staged file, and its default extensions cover both. .clang-format-ignore is no
# substitute: under --staged the content arrives on stdin with -assume-filename,
# where the ignore file is never read, and in working-tree mode an ignored file
# formats to zero bytes, which git-clang-format offers back as a truncation.
Language: Json
DisableFormat: true
---
Language: Proto
DisableFormat: true
