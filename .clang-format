Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
UseTab: Never
# Break long fluent chains (display->invalidateScreen()->...) instead of one line.
ColumnLimit: 100
ContinuationIndentWidth: 0
BreakBeforeBraces: Attach
SpaceBeforeParens: ControlStatements
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false
AccessModifierOffset: -4
BreakConstructorInitializers: BeforeComma
ConstructorInitializerIndentWidth: 4
IndentCaseLabels: true
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortCaseLabelsOnASingleLine: true
FixNamespaceComments: false
SpacesBeforeTrailingComments: 2
# The styleguide groups includes by subsystem and Arduino order is load-bearing; SortIncludes cannot express either.
SortIncludes: Never

---
Language: Json
# Our JSON files are hand-maintained; clang-format only needs to accept the
# language so git-clang-format (whose default extensions include json) stops
# erroring on a staged .json. .clang-format-ignore cannot do this: the content
# arrives on stdin under -assume-filename, where the ignore file is not read.
DisableFormat: true
